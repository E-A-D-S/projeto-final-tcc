APP_NAME="Clinica ULBRA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Banco de dados ---
# Local (mais simples): SQLite
#   DB_CONNECTION=sqlite  e rode:  touch database/database.sqlite
#
# Producao (Render + Neon): PostgreSQL via DATABASE_URL
DB_CONNECTION=sqlite
# DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# E-mail em modo log: nao dispara envio real, so registra no log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responder@clinica-ulbra.local"
MAIL_FROM_NAME="${APP_NAME}"
